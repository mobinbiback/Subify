{
  "manifest_version": 3,
  "name": "Subify",
  "short_name": "Subify",
  "version": "2.9.41",
  "description": "ترجمه مستقیم زیرنویس زمان‌بندی‌شده YouTube با Cache ابری پایدار، ترجمه پیش‌دستانه و خروجی SRT، VTT و TXT.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "downloads",
    "tabs",
    "offscreen",
    "tabCapture",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://sub-ify.site/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.udemy.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://vimeo.com/*",
        "https://*.vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://www.aparat.com/*",
        "https://aparat.com/*",
        "https://www.coursera.org/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.udemy.com/*",
        "https://www.linkedin.com/*",
        "https://courses.edx.org/*",
        "https://learning.edx.org/*",
        "https://*.h5p.com/*",
        "https://www.ted.com/*",
        "https://www.khanacademy.org/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*"
      ],
      "all_frames": true,
      "js": [
        "learning-core.js",
        "subtitle-overlay.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "all_frames": false,
      "js": [
        "meet-captions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.udemy.com/*"
      ]
    },
    {
      "resources": [
        "icons/*.png",
        "fonts/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://vimeo.com/*",
        "https://*.vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://www.aparat.com/*",
        "https://aparat.com/*",
        "https://www.coursera.org/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.udemy.com/*",
        "https://www.linkedin.com/*",
        "https://courses.edx.org/*",
        "https://learning.edx.org/*",
        "https://*.h5p.com/*",
        "https://www.ted.com/*",
        "https://www.khanacademy.org/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*"
      ]
    },
    {
      "resources": [
        "fonts/Vazirmatn-Regular.ttf",
        "fonts/Estedad-Medium.ttf",
        "fonts/Lalezar-Regular.ttf",
        "fonts/Sahel-Bold.ttf",
        "fonts/AradFD-Regular.woff2",
        "fonts/Inter-400.woff2",
        "fonts/Poppins-500.woff2",
        "fonts/Montserrat-500.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
